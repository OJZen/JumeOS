# R46H v0.15 gaming product p2 one-shot; p1 and persistent environment stay unchanged.
mmc dev 1
setenv loadaddr 0x02000000
setenv dtb_loadaddr 0x01f00000
setenv bootargs "root=PARTUUID=c9f931c9-02 rootwait rw fsck.repair=yes net.ifnames=0 console=ttyS2,115200n8 earlycon loglevel=7 ignore_loglevel plymouth.enable=0 clk_ignore_unused pd_ignore_unused"
if ext4load mmc 1:2 ${loadaddr} /var/lib/r46h-gaming-product-kernel/v0.15-gaming-product/IMAGE; then
  if itest ${filesize} -eq 0x27a5200; then
    if ext4load mmc 1:2 ${dtb_loadaddr} /var/lib/r46h-gaming-product-kernel/v0.15-gaming-product/R46H.DTB; then
      if itest ${filesize} -eq 0xc16e; then
        booti ${loadaddr} - ${dtb_loadaddr}
      else
        echo "R46H v0.15-gaming-product: DTB size mismatch"
      fi
    else
      echo "R46H v0.15-gaming-product: DTB load failed"
    fi
  else
    echo "R46H v0.15-gaming-product: Image size mismatch"
  fi
else
  echo "R46H v0.15-gaming-product: Image load failed"
fi
