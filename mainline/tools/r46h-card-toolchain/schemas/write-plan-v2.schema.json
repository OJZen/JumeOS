{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkos4clone.invalid/schemas/r46h-card-write-plan-v2.json",
  "$comment": "Structural authoring aid only. The r46h-card CLI schema-check command is the authoritative semantic validator; this schema does not authorize execution or writes.",
  "title": "R46H write plan v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "plan_id", "profile_id", "target_stable_id", "verification", "operations", "unchanged_ranges"],
  "properties": {
    "format_version": { "const": 2 },
    "plan_id": { "$ref": "#/$defs/id" },
    "profile_id": { "$ref": "#/$defs/id" },
    "target_stable_id": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "\\S" },
    "verification": { "enum": ["quick", "balanced", "full"] },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/operation" }
    },
    "unchanged_ranges": {
      "type": "array",
      "items": { "$ref": "#/$defs/range" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "size", "sha256"],
      "properties": {
        "relative_path": { "type": "string", "minLength": 1 },
        "size": { "type": "integer", "minimum": 1, "maximum": 18446744073709551615 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "precondition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "sha256"],
          "properties": {
            "kind": { "const": "exact_sha256" },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "destructive", "rationale"],
          "properties": {
            "kind": { "const": "disposable" },
            "destructive": { "const": true },
            "rationale": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "\\S" }
          }
        }
      ]
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "partition", "source", "target_before"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "partition": { "enum": ["boot", "root", "easyroms"] },
        "source": { "$ref": "#/$defs/source" },
        "target_before": { "$ref": "#/$defs/precondition" }
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "offset", "length", "sha256_before"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "offset": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 },
        "length": { "type": "integer", "minimum": 1, "maximum": 18446744073709551615 },
        "sha256_before": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
