# Unbooted optional candidate; do not merge into the accepted product config.
# Linux 6.12.99: compressed swap support, without activating any swap device.
CONFIG_SWAP=y
CONFIG_ZRAM=m
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_LZ4=y
# CONFIG_ZRAM_WRITEBACK is not set
# CONFIG_ZRAM_MULTI_COMP is not set
# CONFIG_ZSWAP is not set
