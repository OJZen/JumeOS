# Linux v6.12.99 arm64 defconfig fragment for the R46H test image.
#
# Boot-critical hardware is built in so the serial log remains useful even if
# the initramfs or module installation is incomplete.  Optional or risky
# devices stay modular where unloading/blacklisting is valuable.

# Reproducible test release identity
CONFIG_LOCALVERSION="-r46h-mainline-v0.19-zram-product"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_MODULES=y

# Debian/systemd and initramfs baseline
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_FHANDLE=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_COMPAT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_XZ=y
CONFIG_RD_LZ4=y
CONFIG_RD_ZSTD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_AUTOFS_FS=y

# RK3326/PX30 core platform and power management
CONFIG_ARCH_ROCKCHIP=y
CONFIG_CPU_IDLE=y
CONFIG_ARM_PSCI_CPUIDLE=y
CONFIG_CPU_FREQ=y
CONFIG_CPUFREQ_DT=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_SUSPEND=y
CONFIG_PM_SLEEP=y
CONFIG_PM_DEBUG=y
CONFIG_PM_ADVANCED_DEBUG=y
CONFIG_I2C=y
CONFIG_I2C_RK3X=y
CONFIG_PINCTRL=y
CONFIG_PINCTRL_ROCKCHIP=y
CONFIG_GPIO_ROCKCHIP=y
CONFIG_ROCKCHIP_GRF=y
CONFIG_ROCKCHIP_IODOMAIN=y
CONFIG_ROCKCHIP_PM_DOMAINS=y
CONFIG_ROCKCHIP_IOMMU=y
CONFIG_NVMEM_ROCKCHIP_EFUSE=y
CONFIG_NVMEM_ROCKCHIP_OTP=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_PWM=y
CONFIG_PWM_ROCKCHIP=y

# UART2/early console and local framebuffer console
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# Rockchip VOP + DesignWare MIPI-DSI + provisional R46H panel
CONFIG_DRM=y
CONFIG_DRM_ROCKCHIP=y
CONFIG_ROCKCHIP_VOP=y
CONFIG_ROCKCHIP_DW_MIPI_DSI=y
CONFIG_DRM_MIPI_DSI=y
CONFIG_DRM_PANEL=y
CONFIG_DRM_PANEL_SIMPLE=y
CONFIG_DRM_PANEL_R46H=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_PHY_ROCKCHIP_INNO_DSIDPHY=y

# Mali-G31/Panfrost, devfreq and thermal protection
CONFIG_DRM_PANFROST=y
CONFIG_PM_DEVFREQ=y
CONFIG_DEVFREQ_GOV_SIMPLE_ONDEMAND=y
CONFIG_THERMAL=y
CONFIG_THERMAL_NETLINK=y
CONFIG_THERMAL_STATISTICS=y
CONFIG_THERMAL_DEBUGFS=y
CONFIG_THERMAL_OF=y
CONFIG_CPU_THERMAL=y
CONFIG_DEVFREQ_THERMAL=y
CONFIG_ROCKCHIP_THERMAL=y

# RK817 PMIC, regulators, power key, RTC and battery charger
CONFIG_MFD_RK8XX=y
CONFIG_MFD_RK8XX_I2C=y
CONFIG_PINCTRL_RK805=y
CONFIG_INPUT_RK805_PWRKEY=y
CONFIG_REGULATOR_RK808=y
CONFIG_COMMON_CLK_RK808=y
CONFIG_RTC_DRV_RK808=y
CONFIG_CHARGER_RK817=m

# RK817 I2S audio path
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_ROCKCHIP=y
CONFIG_SND_SOC_ROCKCHIP_I2S_TDM=y
CONFIG_SND_SOC_RK817=y
CONFIG_SND_SIMPLE_CARD=y

# Both removable TF slots and their ext4 root filesystem
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y
CONFIG_MMC_CQHCI=y
# CONFIG_MMC_HSQ is not set

# Internal DWC2 host, hub and Realtek 0bda:8179 Wi-Fi
CONFIG_USB=y
CONFIG_USB_ANNOUNCE_NEW_DEVICES=y
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_HOST=y
# CONFIG_USB_DWC2_PERIPHERAL is not set
# CONFIG_USB_DWC2_DUAL_ROLE is not set
CONFIG_USB_HID=y
CONFIG_USB_STORAGE=y
CONFIG_PHY_ROCKCHIP_INNO_USB2=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_RFKILL=m
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTL8XXXU=m
# CONFIG_RTL8XXXU_UNTESTED is not set
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_DEBUG=y
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_XZ=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y

# GPIO keys, muxed ADC sticks, LEDs and PWM rumble
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_UINPUT=y
CONFIG_INPUT_JOYSTICK=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_JOYSTICK_ADC=y
CONFIG_INPUT_PWM_VIBRA=y
CONFIG_IIO=y
CONFIG_ROCKCHIP_SARADC=y
CONFIG_IIO_MUX=y
CONFIG_MULTIPLEXER=y
CONFIG_MUX_GPIO=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_GPIO=y

# PX30 Hantro VPU (non-boot-critical)
CONFIG_MEDIA_SUPPORT=m
CONFIG_MEDIA_CONTROLLER=y
CONFIG_V4L_MEM2MEM_DRIVERS=y
CONFIG_VIDEO_HANTRO=m
CONFIG_VIDEO_HANTRO_ROCKCHIP=y

# Debian root, BOOT and EASYROMS filesystem support
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=m
CONFIG_FUSE_FS=m
CONFIG_OVERLAY_FS=m
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y

# Bring-up diagnostics without the storage cost of compiler debug info
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_PRINTK_TIME=y
CONFIG_LOG_BUF_SHIFT=18
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_FS=y
CONFIG_DYNAMIC_DEBUG=y
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y
CONFIG_DEBUG_INFO_NONE=y

# Product compressed swap: 256 MiB LZ4 is activated by r46h-zram.service.
CONFIG_SWAP=y
CONFIG_ZRAM=m
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_LZ4=y
# CONFIG_ZRAM_WRITEBACK is not set
# CONFIG_ZRAM_MULTI_COMP is not set
# CONFIG_ZSWAP is not set
