#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

readonly MARKER=/var/lib/r46h/firstboot-complete
readonly TEMP_MARKER=/var/lib/r46h/.firstboot-complete.$$

cleanup() {
  rm -f -- "$TEMP_MARKER"
}
trap cleanup EXIT

[[ "$(id -u)" == 0 ]] || {
  printf 'R46H_FIRSTBOOT result=fail reason=not-root\n' >&2
  exit 1
}

install -d -o root -g root -m 0755 /var/lib/r46h
if [[ ! -s /etc/machine-id ]]; then
  systemd-machine-id-setup
fi
ssh-keygen -A
compgen -G '/etc/ssh/ssh_host_*_key' >/dev/null || {
  printf 'R46H_FIRSTBOOT result=fail reason=no-ssh-host-key\n' >&2
  exit 1
}
install -d -o root -g root -m 0755 /run/sshd
/usr/sbin/sshd -t

printf 'release=debian13-p2-mvp-v0.1\n' > "$TEMP_MARKER"
chmod 0600 "$TEMP_MARKER"
mv -f -- "$TEMP_MARKER" "$MARKER"
sync
printf 'R46H_FIRSTBOOT result=pass release=debian13-p2-mvp-v0.1\n'
