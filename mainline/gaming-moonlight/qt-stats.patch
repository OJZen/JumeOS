+static QJsonObject r46hVideoStats(const VIDEO_STATS& stats, int audioNetworkQueueMs)
+{
+    auto average = [](double total, uint32_t count) { return count ? total / count : -1.; };
+    auto rate = [](float value) { return std::isfinite(value) && value >= 0 ? double(value) : -1.; };
+    return {{"version", 1}, {"receivedFps", rate(stats.receivedFps)},
+        {"decodedFps", rate(stats.decodedFps)}, {"renderedFps", rate(stats.renderedFps)},
+        {"networkDropPercent", average(double(stats.networkDroppedFrames) * 100, stats.totalFrames)},
+        {"pacingDropPercent", average(double(stats.pacerDroppedFrames) * 100, stats.decodedFrames)},
+        {"decodeMs", average(stats.totalDecodeTime, stats.decodedFrames)},
+        {"queueMs", average(stats.totalPacerTime, stats.renderedFrames)},
+        {"renderCallMs", average(stats.totalRenderTime, stats.renderedFrames)},
+        {"rttMs", stats.lastRtt ? double(stats.lastRtt) : -1.},
+        {"hostProcessingMs", average(double(stats.totalHostProcessingLatency) / 10, stats.framesWithHostProcessingLatency)},
+        {"audioNetworkQueueMs", audioNetworkQueueMs}};
+}
