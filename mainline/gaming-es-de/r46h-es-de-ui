#!/bin/bash
set -Eeuo pipefail

PATH=/usr/sbin:/usr/bin:/sbin:/bin
LC_ALL=C
LANG=C.UTF-8
export PATH LC_ALL LANG

readonly EXPECTED_RELEASE=6.12.99-r46h-mainline-v0.15-gaming-product
readonly EXPECTED_ROOT_PARTUUID=c9f931c9-02
readonly EXPECTED_ROOT_UUID=d3130007-46a4-4d56-9001-000000000007
readonly BASE_RECEIPT=/var/lib/r46h/gaming-ozone-fbneo-v0.1-installed
readonly BASE_RECEIPT_SHA256=8acac2c8b8e4295c0235ad1fc7e396e341dcc4b1ba771a053355a98cf8fb73ec
readonly FEATURE_RECEIPT=/var/lib/r46h/gaming-es-de-v0.1-installed
readonly ES_DE=/opt/r46h/es-de/bin/es-de
readonly ES_DE_SHA256=9c6e50433b9bca5ac1c01030bc4d7b143f05c2cd27c52e6f5f765b0acf01be98
readonly SYSTEMS=/etc/r46h/es-de-systems.xml
readonly SYSTEMS_SHA256=1f451723d4ce1062157eb0e041ff4c098c5adea98c61e87ddf3cb784dfe630f0
readonly RETROARCH_APPEND=/etc/r46h/es-de-retroarch.cfg
readonly RETROARCH_APPEND_SHA256=2e13e4d33ca23e67d7b52ce6c9c85045b39e3f2ff76bbd6d68c8ca2295ddcb7f
readonly ACCEPTED_CONFIG=/etc/r46h/retroarch.cfg
readonly ACCEPTED_CONFIG_SHA256=0694b9f41220983bdf9d60789b97b2fe115f68474f22f4869a2764513bcf1835
readonly FBNEO_CORE=/usr/local/libexec/fbneo_neogeo_libretro.so
readonly FBNEO_CORE_SHA256=8bb17a551f3eeeb384ab00a5c5375d30eb63807afe5b6c1ba1d3f78220732bdb
readonly FBNEO_OPTIONS='/home/ark/.config/retroarch/config/FinalBurn Neo (neogeo subset)/FinalBurn Neo (neogeo subset).opt'
readonly FBNEO_OPTIONS_SHA256=4e67299bc6c37cd1ebdfca4e6a42110d5071c62d00e714b952b906ca1fa68976
readonly ES_CORE_OPTIONS=/home/ark/.config/retroarch/r46h-es-de-core-options.cfg
readonly CJK_FONT=/usr/share/fonts/truetype/droid/DroidSansFallbackFull.ttf
readonly CJK_FONT_SHA256=acb6440a713d880a13a21b468ba7cd43f5a2b2934972e51be791c880730777b8
readonly CJK_ALIAS=/usr/share/libretro/assets/pkg/chinese-fallback-font.ttf
readonly CJK_ALIAS_TARGET=../../../fonts/truetype/droid/DroidSansFallbackFull.ttf
readonly MUX_CONTROL=5
readonly GAME_MUX=0
readonly CONTROLLER_MAPPING='06004e84465200004800000001000000,R46H Combined Gamepad,a:b1,b:b0,x:b2,y:b3,back:b8,start:b9,leftshoulder:b4,rightshoulder:b5,lefttrigger:b6,righttrigger:b7,leftstick:b14,rightstick:b15,leftx:a0,lefty:a1,rightx:a2,righty:a3,dpup:b10,dpdown:b11,dpleft:b12,dpright:b13,platform:Linux,'

saved_mux=""
mux_changed=0
session_dir=""
session_log=""
launcher_pid=""
process_cleanup=pass

die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

control_values() {
  amixer -c 0 cget "numid=$1" 2>/dev/null |
    awk -F= '/^[[:space:]]*: values=/ { print $2; found=1 } END { exit found ? 0 : 1 }'
}

process_group_is_empty() {
  local group_id=$1
  local -a pipeline_status
  /usr/bin/ps -eo pgid= |
    awk -v group_id="$group_id" '$1 == group_id { found=1 } END { exit found ? 1 : 0 }'
  pipeline_status=("${PIPESTATUS[@]}")
  [[ ${pipeline_status[0]} == 0 ]] || return 1
  return "${pipeline_status[1]}"
}

stop_launcher_group() {
  local poll own_group
  [[ $launcher_pid =~ ^[1-9][0-9]*$ ]] || return 0
  own_group=$(/usr/bin/ps -o pgid= -p $$ 2>/dev/null | awk '{ print $1 }')
  [[ -n $own_group && $launcher_pid != "$own_group" ]] || return 1
  process_group_is_empty "$launcher_pid" || kill -TERM -- "-$launcher_pid" 2>/dev/null || true
  for ((poll=0; poll<30; poll++)); do
    process_group_is_empty "$launcher_pid" && break
    /usr/bin/sleep 0.1
  done
  process_group_is_empty "$launcher_pid" || kill -KILL -- "-$launcher_pid" 2>/dev/null || true
  process_group_is_empty "$launcher_pid"
}

cleanup() {
  local status=$?
  trap - EXIT INT TERM HUP
  set +e
  trap '' INT TERM HUP
  if [[ -n $launcher_pid ]]; then
    stop_launcher_group || { process_cleanup=fail; status=1; }
    wait "$launcher_pid" 2>/dev/null || true
  fi
  if (( mux_changed == 1 )); then
    amixer -q -c 0 cset "numid=$MUX_CONTROL" "$saved_mux"
  fi
  if [[ $status != 0 && -f $session_log && ! -L $session_log ]]; then
    printf '%s\n' 'R46H_ES_DE log_tail=begin' >&2
    tail -n 100 -- "$session_log" >&2
    printf '%s\n' 'R46H_ES_DE log_tail=end' >&2
  fi
  [[ -z $session_log ]] || rm -f -- "$session_log"
  [[ -z $session_dir ]] || rmdir -- "$session_dir" 2>/dev/null || true
  chvt 1 >/dev/null 2>&1 || true
  printf 'R46H_ES_DE result=%s status=%d mux_restored=%s process_cleanup=%s\n' \
    "$([[ $status == 0 ]] && printf pass || printf fail)" "$status" \
    "$([[ $mux_changed == 1 ]] && printf yes || printf not-needed)" "$process_cleanup"
  exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

(( EUID == 0 )) || die 'root is required'
[[ $# == 0 ]] || die 'this launcher takes no arguments'
[[ $(uname -r) == "$EXPECTED_RELEASE" ]] || die 'boot the exact v0.15 gaming product kernel first'
[[ $(findmnt -rn -o PARTUUID /) == "$EXPECTED_ROOT_PARTUUID" ]] || die 'unexpected root partition'
[[ $(findmnt -rn -o UUID /) == "$EXPECTED_ROOT_UUID" ]] || die 'unexpected root filesystem'
[[ ,$(findmnt -rn -o OPTIONS /roms), == *,ro,* ]] || die '/roms is not mounted read-only'
for receipt in "$BASE_RECEIPT" "$FEATURE_RECEIPT"; do
  [[ -f $receipt && ! -L $receipt ]] || die "install receipt is missing: $receipt"
  [[ $(stat -c '%u:%a:%h' "$receipt") == 0:600:1 ]] || die "receipt metadata is invalid: $receipt"
done
grep -Fqx 'feature_id=r46h-gaming-es-de-v0.1' "$FEATURE_RECEIPT" || die 'ES-DE receipt identity is invalid'
for pair in \
  "$BASE_RECEIPT:$BASE_RECEIPT_SHA256" \
  "$ES_DE:$ES_DE_SHA256" \
  "$SYSTEMS:$SYSTEMS_SHA256" \
  "$RETROARCH_APPEND:$RETROARCH_APPEND_SHA256" \
  "$ACCEPTED_CONFIG:$ACCEPTED_CONFIG_SHA256" \
  "$FBNEO_CORE:$FBNEO_CORE_SHA256" \
  "$FBNEO_OPTIONS:$FBNEO_OPTIONS_SHA256" \
  "$CJK_FONT:$CJK_FONT_SHA256"; do
  path=${pair%%:*}
  expected=${pair#*:}
  [[ -f $path && ! -L $path ]] || die "missing runtime: $path"
  [[ $(sha256sum "$path" | awk '{print $1}') == "$expected" ]] || die "runtime identity mismatch: $path"
done
[[ -f $ES_CORE_OPTIONS && ! -L $ES_CORE_OPTIONS ]] || die 'ES-DE core options are missing'
[[ $(stat -c '%u:%g:%a:%h' "$ES_CORE_OPTIONS") == 1000:1000:600:1 ]] || \
  die 'ES-DE core options metadata is unsafe'
[[ -L $CJK_ALIAS && $(readlink -- "$CJK_ALIAS") == "$CJK_ALIAS_TARGET" ]] || \
  die 'RetroArch Chinese font alias changed'
for path in \
  /usr/bin/retroarch \
  /usr/lib/aarch64-linux-gnu/libretro/nestopia_libretro.so \
  /usr/lib/aarch64-linux-gnu/libretro/gambatte_libretro.so \
  /usr/lib/aarch64-linux-gnu/libretro/mgba_libretro.so \
  /usr/lib/aarch64-linux-gnu/libretro/desmume_libretro.so \
  /usr/local/libexec/fbneo_neogeo_libretro.so; do
  [[ -f $path && ! -L $path ]] || die "missing emulator runtime: $path"
done
while IFS=$'\t' read -r system source; do
  [[ -n $system && ${system:0:1} != '#' ]] || continue
  [[ -L /home/ark/ROMs/$system ]] || die "missing ROM allowlist link: $system"
  [[ $(readlink -- /home/ark/ROMs/$system) == "$source" ]] || die "unexpected ROM allowlist target: $system"
done < /var/lib/r46h-gaming-es-de/v0.1/system-links.tsv
[[ $(id -u ark) == 1000 ]] || die 'unexpected ark user identity'
[[ -c /dev/dri/card0 && -c /dev/dri/renderD128 ]] || die 'DRM nodes are unavailable'
grep -Fq rk817-hifi /proc/asound/pcm || die 'RK817 playback device is unavailable'

install -d -o ark -g ark -m 0700 /run/user/1000
session_dir=$(/usr/bin/mktemp -d /run/r46h-es-de.XXXXXX)
chmod 0700 "$session_dir"
session_log=$session_dir/es-de.log
install -o root -g root -m 0600 /dev/null "$session_log"
saved_mux=$(control_values "$MUX_CONTROL")
[[ $saved_mux =~ ^[0-9]+$ ]] || die 'cannot read RK817 mixer controls'
mux_changed=1
amixer -q -c 0 cset "numid=$MUX_CONTROL" "$GAME_MUX"

printf 'R46H_ES_DE phase=start vt=2 kernel=%s renderer=opengles2 systems=7\n' "$(uname -r)"
/usr/bin/setsid /usr/bin/openvt -e -c 2 -s -f -- /bin/dash -c '
  session_log=$1
  controller_mapping=$2
  exec /usr/sbin/runuser -u ark -- /usr/bin/env \
    HOME=/home/ark \
    XDG_RUNTIME_DIR=/run/user/1000 \
    LD_LIBRARY_PATH=/opt/r46h/es-de/lib/aarch64-linux-gnu:/opt/r46h/es-de/lib \
    MESA_SHADER_CACHE_DISABLE=true \
    SDL_AUDIODRIVER=alsa \
    SDL_GAMECONTROLLERCONFIG="$controller_mapping" \
    SDL_VIDEODRIVER=kmsdrm \
    /opt/r46h/es-de/bin/es-de --resolution 1024 768 --no-splash \
      >"$session_log" 2>&1
' r46h-es-de-session "$session_log" "$CONTROLLER_MAPPING" &
launcher_pid=$!
set +e
wait "$launcher_pid"
launcher_status=$?
set -e
exit "$launcher_status"
